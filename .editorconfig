root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = false

[*.{hpp,hpp.in,cpp,mm,hlsl}]
max_line_length = 120

[{*.yml,.clang-format,.clang-tidy}]
indent_size = 2

[ThirdParty/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
max_line_length = unset